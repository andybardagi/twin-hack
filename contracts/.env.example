ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
DEPLOYER_PRIVATE_KEY=0x...
RELAYER_PRIVATE_KEY=0x...
# Merchant wallet; sends setSigningKey / setPayoutAddress.
MERCHANT_PRIVATE_KEY=0x...
# Device key that signs orders; registered via setSigningKey.
MERCHANT_SIGNER_PRIVATE_KEY=0x...
CUSTOMER_PRIVATE_KEY=0x...
PAYMENT_ROUTER_ADDRESS=0x...
# Optional, only for --verify. Etherscan v2 key (covers Arbitrum).
ETHERSCAN_API_KEY=
